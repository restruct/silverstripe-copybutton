{
    "name": "restruct/silverstripe-copybutton",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "description": "A Copy action for Silverstripe GridField rows: duplicate a record in one click, from the row action menu or an icon button, and optionally open the copy.",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "gridfield",
        "modeladmin",
        "copy",
        "duplicate"
    ],
    "authors": [
        {
            "name": "Elvinas Liutkevičius",
            "email": "elvinas@unisolutions.eu"
        },
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/vendor-plugin": "^2 || ^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Unisolutions\\": "code/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unisolutions\\Tests\\": "tests/"
        }
    },
    "replace": {
        "unisolutions/silverstripe-copybutton": "self.version",
        "dhensby/silverstripe-copybutton": "self.version"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        },
        "expose": [
            "css"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
